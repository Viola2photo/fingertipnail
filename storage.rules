rules_version = '2';

// 商品照片公開可讀，只有店家帳號可以上傳或刪除。部署：firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'MvkJo5e1kEcBS0fGGMr4RKdQjYg1';
    }
  }
}
